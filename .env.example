# GLA Portal V2 - Environment Configuration
# Copy this file to .env and fill in the values

# API URL - Backend server URL
# In development: leave empty to use Vite proxy (recommended)
# In production: set to your backend URL (e.g., https://api.glamanagement.com)
VITE_API_URL=

# App metadata
VITE_APP_NAME=GLA Management Portal
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Premium fleet management and luxury auto services portal

# Google reCAPTCHA site key (for public forms)
VITE_RECAPTCHA_SITE_KEY=

# Feature flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
