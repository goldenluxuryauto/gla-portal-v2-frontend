{
  "version": 2,
  "name": "gla-portal-v2-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://gla-portal-v2-backend.onrender.com",
    "VITE_APP_NAME": "GLA Management Portal",
    "VITE_APP_VERSION": "2.0.0",
    "VITE_ENABLE_PWA": "true"
  }
}